<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="28dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/slate_100"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp">

        <!-- Top header with lock icon and close button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_icon_tile_blue"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Mã PIN"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/brand_600" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnClosePinPopup"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/slate_500" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvPinPopupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Xác thực Mã PIN"
            android:textColor="@color/slate_900"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPinPopupSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Nhập mã PIN thẻ sinh viên của bạn"
            android:textColor="@color/slate_500"
            android:textSize="13sp" />

        <!-- 6 PIN dots -->
        <LinearLayout
            android:id="@+id/pinDotsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvPinPopupError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:minHeight="18dp"
            android:text=""
            android:textColor="@color/red_600"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- §1.2 / §5.2 demo: PBKDF2 cost + PIN zeroization readout -->
        <TextView
            android:id="@+id/tvPinCryptoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/slate_500"
            android:textSize="10sp" />

        <!-- Numeric Keypad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPin1"
                style="@style/Widget.SmartID.Button.Key"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPin2"
                style="@style/Widget.SmartID.Button.Key"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPin3"
                style="@style/Widget.SmartID.Button.Key"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPin4"
                style="@style/Widget.SmartID.Button.Key"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPin5"
                style="@style/Widget.SmartID.Button.Key"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPin6"
                style="@style/Widget.SmartID.Button.Key"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPin7"
                style="@style/Widget.SmartID.Button.Key"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPin8"
                style="@style/Widget.SmartID.Button.Key"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPin9"
                style="@style/Widget.SmartID.Button.Key"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPin0"
                style="@style/Widget.SmartID.Button.Key"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPinBackspace"
                style="@style/Widget.SmartID.Button.KeyIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:contentDescription="Xóa"
                app:icon="@drawable/ic_backspace" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPinPopup"
            style="@style/Widget.SmartID.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:text="Xác nhận" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
