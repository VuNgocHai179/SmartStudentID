<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Brand mark -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_blue"
                android:gravity="center">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_school"
                    app:tint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.16"
            android:text="SMART STUDENT ID"
            android:textColor="@color/brand_600"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Thẻ Sinh Viên Thông Minh"
            android:textAppearance="@style/TextAppearance.SmartID.ScreenTitle" />

        <TextView
            android:id="@+id/tvSessionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Cổng định danh &amp; tiện ích học vụ điện tử"
            android:textAppearance="@style/TextAppearance.SmartID.Caption" />

        <!-- Center Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- STATE 1: NFC Waiting Zone (Shown when no card session is active) -->
                <LinearLayout
                    android:id="@+id/layoutNfcScanZone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_soft_panel"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:background="@drawable/bg_qr_ring">

                        <LinearLayout
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_icon_tile_blue"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:contentDescription="NFC"
                                android:src="@drawable/ic_nav_card"
                                app:tint="@color/brand_600" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvNfcPromptTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="Đưa thẻ sinh viên lại gần NFC thiết bị"
                        android:textColor="@color/slate_900"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNfcPromptSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="Áp mặt thẻ sinh viên vào lưng điện thoại để tự động nhận diện"
                        android:textColor="@color/slate_500"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- STATE 2: Saved Card Session View (Shown when a card is already bound) -->
                <LinearLayout
                    android:id="@+id/layoutSavedCardZone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_soft_panel"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_tile_blue"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="Thẻ sinh viên"
                                android:src="@drawable/ic_nav_card"
                                app:tint="@color/brand_600" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCardHolderName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vũ Ngọc Hải • CT070315"
                                android:textColor="@color/slate_900"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRsaChallengeStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="An toàn Thông tin"
                                android:textColor="@color/slate_500"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Đã bảo vệ"
                            android:src="@drawable/ic_verified"
                            app:tint="@color/emerald_600" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrimaryLogin"
                        style="@style/Widget.SmartID.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="20dp"
                        android:text="Mở khóa ứng dụng"
                        android:textSize="15sp"
                        app:icon="@drawable/ic_login" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogoutSavedCard"
                        style="@style/Widget.SmartID.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:text="Đăng xuất thẻ"
                        android:textColor="@color/red_600"
                        app:icon="@drawable/ic_close"
                        app:iconTint="@color/red_600" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLoginFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text=""
                    android:textColor="@color/amber_600"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Subtle secondary action for Admin portal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenAdminDashboard"
            style="@style/Widget.SmartID.Button.Soft"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="22dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Chế độ Quản trị"
            android:textSize="13sp"
            app:icon="@drawable/ic_person" />

    </LinearLayout>
</ScrollView>
