<?xml version="1.0" encoding="utf-8"?>
<!-- Clean, spacious Light Mode layout for Login & Smart PIN Session (CN 2.1, 2.2, 2.3) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="30dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Brand mark -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="66dp"
            android:layout_height="66dp"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_blue"
                android:gravity="center">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_school"
                    app:tint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.16"
            android:text="SMART STUDENT ID"
            android:textColor="@color/brand_600"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Thẻ Sinh Viên Thông Minh"
            android:textAppearance="@style/TextAppearance.SmartID.ScreenTitle" />

        <TextView
            android:id="@+id/tvSessionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Đăng nhập an toàn bằng mã PIN"
            android:textAppearance="@style/TextAppearance.SmartID.Caption" />

        <!-- Main authentication card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- First-time RSA scan section -->
                <LinearLayout
                    android:id="@+id/cardFirstTimeScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_soft_panel"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_tile_blue"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:contentDescription="Xác thực RSA"
                                android:src="@drawable/ic_verified"
                                app:tint="@color/brand_600" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bước 1 • Xác thực thẻ"
                                android:textColor="@color/slate_900"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanAndVerifyRsa"
                        style="@style/Widget.SmartID.Button.Soft"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:text="Quét thẻ &amp; xác thực RSA"
                        app:icon="@drawable/ic_verified" />

                    <TextView
                        android:id="@+id/tvRsaChallengeStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Chưa quét thẻ."
                        android:textAppearance="@style/TextAppearance.SmartID.Micro"
                        android:textColor="@color/emerald_600" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="@color/slate_100" />

                <TextView
                    android:id="@+id/tvPinCardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Nhập Mã PIN (6 chữ số)"
                    android:textColor="@color/slate_900"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPinLockWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Mã PIN mặc định: 123456"
                    android:textAppearance="@style/TextAppearance.SmartID.Caption" />

                <!-- PIN dots (rebuilt at runtime by LoginPinActivity) -->
                <LinearLayout
                    android:id="@+id/pinDotsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pin_dot_empty" />
                </LinearLayout>

                <!-- Hidden numeric field keeps the existing authentication logic intact -->
                <EditText
                    android:id="@+id/etStudentPin"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:importantForAccessibility="no"
                    android:inputType="numberPassword"
                    android:maxLength="8"
                    android:text="123456"
                    android:visibility="gone" />

                <!-- Numeric keypad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPin1"
                        style="@style/Widget.SmartID.Button.Key"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp"
                        android:text="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPin2"
                        style="@style/Widget.SmartID.Button.Key"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp"
                        android:text="2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPin3"
                        style="@style/Widget.SmartID.Button.Key"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp"
                        android:text="3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPin4"
                        style="@style/Widget.SmartID.Button.Key"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp"
                        android:text="4" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPin5"
                        style="@style/Widget.SmartID.Button.Key"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp"
                        android:text="5" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPin6"
                        style="@style/Widget.SmartID.Button.Key"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp"
                        android:text="6" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPin7"
                        style="@style/Widget.SmartID.Button.Key"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp"
                        android:text="7" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPin8"
                        style="@style/Widget.SmartID.Button.Key"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp"
                        android:text="8" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPin9"
                        style="@style/Widget.SmartID.Button.Key"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp"
                        android:text="9" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPin0"
                        style="@style/Widget.SmartID.Button.Key"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp"
                        android:text="0" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPinBackspace"
                        style="@style/Widget.SmartID.Button.KeyIcon"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_margin="6dp"
                        android:contentDescription="Xóa một chữ số"
                        app:icon="@drawable/ic_backspace" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnlockWithPin"
                    style="@style/Widget.SmartID.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="Mở khóa ứng dụng"
                    app:icon="@drawable/ic_login" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchStudentCard"
                    style="@style/Widget.SmartID.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="Đổi thẻ sinh viên khác"
                    android:visibility="gone"
                    app:icon="@drawable/ic_nav_card" />

                <TextView
                    android:id="@+id/tvLoginFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text=""
                    android:textColor="@color/amber_600"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Admin portal & bridge configuration -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DÀNH CHO QUẢN TRỊ"
                    android:textAppearance="@style/TextAppearance.SmartID.Label" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAdminDashboard"
                    style="@style/Widget.SmartID.Button.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:text="Mở chế độ Quản trị"
                    app:icon="@drawable/ic_person" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/slate_100" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BRIDGE SERVER URL"
                    android:textAppearance="@style/TextAppearance.SmartID.Label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etBridgeUrl"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="http://10.0.2.2:8080"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:text="http://10.0.2.2:8080"
                        android:textColor="@color/slate_700"
                        android:textColorHint="@color/slate_400"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyBridgeUrl"
                        style="@style/Widget.SmartID.Button.Outline"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="72dp"
                        android:text="Lưu" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
