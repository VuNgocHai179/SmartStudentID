<?xml version="1.0" encoding="utf-8"?>
<!-- One dedicated demo page per optimization topic (§1–§5). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/demoHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/slate_50"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHÒNG DEMO"
                    android:textAppearance="@style/TextAppearance.SmartID.Label"
                    android:textColor="@color/brand_600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Demo chuyên đề"
                    android:textAppearance="@style/TextAppearance.SmartID.ScreenTitle" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseDemo"
                style="@style/Widget.SmartID.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Đóng" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mỗi chuyên đề một trang riêng — bấm nút để lấy số đo thật trên máy."
            android:textAppearance="@style/TextAppearance.SmartID.Micro" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/demoTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/brand_600"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/brand_600"
        app:tabTextColor="@color/slate_500" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/demoPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
