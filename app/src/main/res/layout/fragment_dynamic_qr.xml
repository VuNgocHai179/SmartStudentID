<?xml version="1.0" encoding="utf-8"?>
<!-- Tab 2: Real-World Class Session Attendance (Lecturer Rotating QR + Backup OTP + Card Reader) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Screen header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điểm danh lớp học"
                    android:textAppearance="@style/TextAppearance.SmartID.ScreenTitle" />

                <TextView
                    android:id="@+id/tvQrStudentSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Vũ Ngọc Hải • CT070315 • Lớp CT7C"
                    android:textAppearance="@style/TextAppearance.SmartID.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshSessions"
                style="@style/Widget.SmartID.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Làm mới"
                app:icon="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- Card 1: Quick QR Scan & Open Class Sessions -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_tile_blue"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Quét QR điểm danh"
                            android:src="@drawable/ic_nav_qr"
                            app:tint="@color/brand_600" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quét QR từ màn chiếu giảng viên"
                            android:textColor="@color/slate_900"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Quét mã QR hoặc chọn ca học đang mở bên dưới"
                            android:textAppearance="@style/TextAppearance.SmartID.Micro" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAttendanceServerPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_green"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="● Sẵn sàng"
                        android:textColor="@color/emerald_700"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanClassQr"
                    style="@style/Widget.SmartID.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="Quét QR trên màn chiếu"
                    app:icon="@drawable/ic_nav_qr" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Ca học đang mở điểm danh"
                    android:textAppearance="@style/TextAppearance.SmartID.SectionTitle" />

                <LinearLayout
                    android:id="@+id/llActiveSessions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvNoActiveSessionHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_soft_panel"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:text="Đang kiểm tra các ca học đang mở điểm danh..."
                    android:textAppearance="@style/TextAppearance.SmartID.Caption" />

                <TextView
                    android:id="@+id/tvAttendanceSignResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_soft_panel"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.SmartID.Micro"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Per-Course Attendance Progress -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_tile_blue"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="Tiến độ điểm danh"
                            android:src="@drawable/ic_history"
                            app:tint="@color/brand_600" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tiến độ điểm danh"
                            android:textColor="@color/slate_900"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Chạm vào từng môn để xem chi tiết các buổi đã học"
                            android:textAppearance="@style/TextAppearance.SmartID.Micro" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAttendanceSummaryPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_blue"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="Đang tải..."
                        android:textColor="@color/brand_600"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llCourseProgressList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvCourseProgressEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_soft_panel"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:text="Đang tải danh sách môn học..."
                    android:textAppearance="@style/TextAppearance.SmartID.Micro"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
