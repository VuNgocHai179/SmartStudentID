<?xml version="1.0" encoding="utf-8"?>
<!-- Layout for Admin Role Dashboard: Issue Card, PUK Unblock & Virtual Card Switcher (CN 1.1, 1.2, 1.3) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👨‍💼 CHẾ ĐỘ ADMIN • PHÒNG ĐÀO TẠO"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quản Lý &amp; Phát Hành Thẻ SV"
                    android:textColor="#F8FAFC"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#334155"
                android:text="← Đăng nhập SV"
                android:textAllCaps="false"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- SECTION 1: ISSUE NEW STUDENT CARD (CN 1.1) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#38BDF8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Phát Hành Thẻ Sinh Viên Mới (Issue New Card — INS 0x20 &amp; 0x13)"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Ghi hồ sơ mã hóa AES-128 xuống EEPROM, nén ảnh thẻ WebP (150x150 ~3.5KB) và yêu cầu thẻ sinh cặp khóa RSA-1024 mới."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etIssueStudentId"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="#0B1120"
                        android:hint="MSSV (VD: CT070350)"
                        android:paddingHorizontal="10dp"
                        android:text="CT070350"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etIssueClassName"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="#0B1120"
                        android:hint="Lớp (VD: CT7C)"
                        android:paddingHorizontal="10dp"
                        android:text="CT7C"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etIssueFullName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#0B1120"
                    android:hint="Họ và tên sinh viên"
                    android:paddingHorizontal="10dp"
                    android:text="Lê Hoàng Nam"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etIssueDob"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="#0B1120"
                        android:hint="Ngày sinh"
                        android:paddingHorizontal="10dp"
                        android:text="12/10/2003"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etIssueDepartment"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1.3"
                        android:background="#0B1120"
                        android:hint="Khoa"
                        android:paddingHorizontal="10dp"
                        android:text="An toàn Thông tin"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnIssueNewCard"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#0284C7"
                    android:text="✨ Phát Hành Thẻ Xuống JCIDE (AES-128 + RSA-1024 + WebP)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIssueCardLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#0B1120"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:text="Sẵn sàng phát hành thẻ mới."
                    android:textColor="#34D399"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 2: UNBLOCK CARD BY ADMIN PUK (CN 1.3 - INS 0x12) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#F59E0B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Mở Khóa Thẻ Bị Khóa PIN Bằng Mã PUK (UNBLOCK CARD — INS 0x12)"
                    android:textColor="#FBBF24"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Khi sinh viên nhập sai PIN 3 lần (SW=6983), Admin nhập mã PUK 8 số (mặc định: 88888888) để gọi OwnerPIN.resetAndUnblock() và đưa PIN về 123456."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etAdminPuk"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="#0B1120"
                        android:gravity="center"
                        android:hint="Mã PUK 8 số"
                        android:inputType="numberPassword"
                        android:maxLength="8"
                        android:text="88888888"
                        android:textColor="#F8FAFC"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnUnblockByPuk"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="10dp"
                        android:backgroundTint="#D97706"
                        android:text="🔓 Mở Khóa PUK"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPukStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Trạng thái mở khóa PUK: Chờ lệnh Admin."
                    android:textColor="#FCD34D"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 3: VIRTUAL CARD SWITCHER & ISSUED CARDS LIST (CN 1.2) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#10B981"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Danh Sách Thẻ SV &amp; Chuyển Đổi Thẻ Ảo Trên JCIDE (Virtual Card Switcher)"
                    android:textColor="#34D399"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Bấm 'Gắn Thẻ Vào JCIDE' để nạp hồ sơ của sinh viên bất kỳ vào đầu đọc thẻ trong &lt; 50ms phục vụ kiểm thử nhiều thẻ."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvIssuedCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 4: ACADEMIC & LIBRARY SUMMARY FOR ADMIN (CN 1.3) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Tổng Hợp Học Vụ: Lịch Sử Điểm Danh RSA &amp; Sách Thư Viện Đang Mượn"
                    android:textColor="#A5B4FC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAdminAcademicSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#0B1120"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:text="Đang tải dữ liệu học vụ..."
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
