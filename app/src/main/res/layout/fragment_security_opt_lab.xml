<?xml version="1.0" encoding="utf-8"?>
<!-- Tab 4 (Demo): Unified Performance & Security Lab with Chaos Tool + Inline §1–§5 Topic Demos -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSecurityOptLab"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <!-- Part 1: Header & Hero Status Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Demo Tối ưu &amp; Bảo mật"
            android:textAppearance="@style/TextAppearance.SmartID.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Gây sự cố hiệu năng &amp; lỗ hổng bảo mật thật, sau đó xử lý trực tiếp theo từng chuyên đề §1–§5."
            android:textAppearance="@style/TextAppearance.SmartID.Caption" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="22dp"
            app:cardElevation="5dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/layoutHeroContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_green"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_glass_pill"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/ivHeroIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Trạng thái hệ thống"
                            android:src="@drawable/ic_verified"
                            app:tint="@color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSecurityHeroStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hệ thống tối ưu • Thiết bị an toàn"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSecurityHeroSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Quy trình 4/4 bước đã hoàn tất • MASVS 5/5"
                            android:textColor="#ECFDF5"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBadgeFps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_pill"
                        android:gravity="center"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="60 FPS"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBadgeCache"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_pill"
                        android:gravity="center"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="AES-GCM"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBadgeWebp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_pill"
                        android:gravity="center"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="WebP 15G"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBadgeMasvs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_pill"
                        android:gravity="center"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="MASVS 5/5"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Part 2: Chaos Control & Live Heartbeat -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CÔNG CỤ GÂY LỖI &amp; NHỊP UI REALTIME"
                    android:textAppearance="@style/TextAppearance.SmartID.Label"
                    android:textColor="@color/red_600" />

                <com.example.smartstudentid.ui.widget.UiHeartbeatView
                    android:id="@+id/heartbeatLab"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvChaosToolStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_soft_panel"
                    android:lineSpacingExtra="3dp"
                    android:padding="10dp"
                    android:text="Hệ thống đang ở trạng thái tối ưu (4/4). Bấm nút đỏ để gây nghẽn FPS, rò rỉ dữ liệu &amp; kiểm chứng."
                    android:textAppearance="@style/TextAppearance.SmartID.Micro" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInjectAllIssues"
                    style="@style/Widget.SmartID.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="46dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="🔥 Gây suy giảm Hiệu năng &amp; Bảo mật (4 Lỗi)"
                    android:textSize="13sp"
                    app:backgroundTint="@color/red_600"
                    app:icon="@drawable/ic_bolt" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRunAutoFixPipeline"
                    style="@style/Widget.SmartID.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="46dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="⚡ Chạy Quy trình Tối ưu Tự động (§2 → §5)"
                    android:textSize="13sp"
                    app:backgroundTint="@color/emerald_600"
                    app:icon="@drawable/ic_verified" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Part 3: Inline 5-Topic TabLayout (§1–§5) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/topicTabs"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/white"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/brand_600"
                app:tabIndicatorHeight="3dp"
                app:tabMode="fixed"
                app:tabPaddingEnd="4dp"
                app:tabPaddingStart="4dp"
                app:tabSelectedTextColor="@color/brand_600"
                app:tabTextColor="@color/slate_500" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Part 4: Topic Header + Before/After Switch + User Action + Chart + Comparison -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTopicBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SmartID.Label"
                android:textColor="@color/brand_600" />

            <TextView
                android:id="@+id/tvTopicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SmartID.Title" />

            <TextView
                android:id="@+id/tvTopicGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textAppearance="@style/TextAppearance.SmartID.Body" />
        </LinearLayout>

        <!-- Topic Mode & Step Action Card (hidden for §1, visible for §2–§5) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTopicMode"
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHẾ ĐỘ CHUYÊN ĐỀ"
                            android:textAppearance="@style/TextAppearance.SmartID.Label"
                            android:textColor="@color/slate_500" />

                        <TextView
                            android:id="@+id/tvModeHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="✓ After — Đã tối ưu"
                            android:textAppearance="@style/TextAppearance.SmartID.Micro"
                            android:textColor="@color/emerald_600"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDemoMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickFixStep"
                    style="@style/Widget.SmartID.Button.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="42dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="🛠 Xử lý Bước này theo quy trình"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Real User Action Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUserAction"
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THAO TÁC NGƯỜI DÙNG THẬT"
                    android:textAppearance="@style/TextAppearance.SmartID.Label"
                    android:textColor="@color/slate_500" />

                <!-- Student card profile panel (§1–§3) -->
                <LinearLayout
                    android:id="@+id/panelStudent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_soft_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/demoAvatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_icon_tile_blue"
                        android:contentDescription="Ảnh thẻ sinh viên"
                        android:padding="10dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        app:tint="@color/brand_600" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/demoName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Chưa có hồ sơ"
                            android:textColor="@color/slate_900"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/demoStudentId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.SmartID.Micro" />

                        <TextView
                            android:id="@+id/demoDept"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.SmartID.Micro" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/demoSourceBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_slate"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text=""
                        android:textColor="@color/slate_600"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Image panel (§4) -->
                <LinearLayout
                    android:id="@+id/panelImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/demoImagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="@drawable/bg_soft_panel"
                        android:contentDescription="Ảnh chân dung sẽ lưu lên thẻ"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_image"
                        app:tint="@color/slate_400" />

                    <TextView
                        android:id="@+id/demoImageInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ảnh mẫu — chưa chọn ảnh"
                        android:textAppearance="@style/TextAppearance.SmartID.Micro" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickImage"
                        style="@style/Widget.SmartID.Button.Soft"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="Chọn ảnh từ thư viện"
                        app:icon="@drawable/ic_image" />
                </LinearLayout>

                <!-- PIN panel (§5) -->
                <LinearLayout
                    android:id="@+id/panelPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nhập PIN để mô phỏng đăng nhập"
                        android:textAppearance="@style/TextAppearance.SmartID.Micro" />

                    <EditText
                        android:id="@+id/demoPinInput"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:importantForAutofill="no"
                        android:inputType="number|textPassword"
                        android:maxLength="8"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="123456"
                        android:textColor="@color/slate_900"
                        android:textSize="16sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDemoAction"
                    style="@style/Widget.SmartID.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    app:icon="@drawable/ic_bolt" />

                <ProgressBar
                    android:id="@+id/demoProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDemoStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.SmartID.Micro" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetCache"
                    style="@style/Widget.SmartID.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="Xóa cache (mô phỏng lần đầu)"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Realtime Telemetry Chart -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvRealtimeChartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ĐỒ THỊ REALTIME"
                    android:textAppearance="@style/TextAppearance.SmartID.Label"
                    android:textColor="@color/slate_500" />

                <TextView
                    android:id="@+id/tvRealtimeChartSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SmartID.Micro" />

                <com.example.smartstudentid.ui.widget.RealtimeTopicChartView
                    android:id="@+id/demoRealtimeChart"
                    android:layout_width="match_parent"
                    android:layout_height="175dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Per-Topic Before / After Comparison Table -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvComparisonTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SO SÁNH BEFORE (LỖI) / AFTER (TỐI ƯU)"
                    android:textAppearance="@style/TextAppearance.SmartID.Label"
                    android:textColor="@color/slate_500" />

                <LinearLayout
                    android:id="@+id/llComparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTopicHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_soft_panel"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.SmartID.Micro" />

        <!-- Part 5: 5-Layer OWASP MASVS Audit & AES/APDU Inspector -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MÔN 2 • KIỂM TOÁN OWASP MASVS"
                    android:textAppearance="@style/TextAppearance.SmartID.Label"
                    android:textColor="@color/emerald_600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Chi tiết 5 Lớp Bảo vệ &amp; Kiểm chứng Dữ liệu"
                    android:textColor="@color/slate_900"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSecurityAuditSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_soft_panel"
                    android:lineSpacingExtra="4dp"
                    android:padding="12dp"
                    android:textColor="@color/slate_700"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInspectCipherAndApdu"
                    style="@style/Widget.SmartID.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="46dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Kiểm chứng Bản mã AES, Plaintext Leak &amp; Log APDU"
                    app:icon="@drawable/ic_lock" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
