<?xml version="1.0" encoding="utf-8"?>
<!-- Main Student container layout in clean, spacious Light Mode with 4 bottom navigation tabs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50"
    android:orientation="vertical">

    <!-- Top header -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_tile_blue"
            android:gravity="center">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_school"
                app:tint="@color/brand_600" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Vũ Ngọc Hải • CT7C"
                android:textColor="@color/slate_900"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderPerfBadge"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_pill_green"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="● Phiên PIN bảo mật • 14 ms"
                android:textColor="@color/emerald_600"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTogglePerfHud"
            style="@style/Widget.SmartID.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="📊 HUD"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHeaderSwitchCard"
            style="@style/Widget.SmartID.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:text="Đăng xuất"
            app:icon="@drawable/ic_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/slate_100" />

    <!-- ViewPager2 hosting the 5 Topic Demo Fragments + Floating Live Perf HUD -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerStudent"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.smartstudentid.ui.widget.LivePerfHudView
            android:id="@+id/livePerfHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:elevation="12dp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/slate_100" />

    <!-- Bottom navigation (5 isolated optimization topic demo tabs §1–§5) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/navTab1"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navIconBg1"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_nav_active">

                <ImageView
                    android:id="@+id/ivNavIcon1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Thẻ Sinh Viên (§1)"
                    android:src="@drawable/ic_nav_card"
                    app:tint="@color/brand_600" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavLabel1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Thẻ SV"
                android:textColor="@color/brand_600"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTab2"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navIconBg2"
                android:layout_width="40dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivNavIcon2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Điểm danh QR (§2)"
                    android:src="@drawable/ic_nav_qr"
                    app:tint="@color/slate_500" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavLabel2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Điểm danh"
                android:textColor="@color/slate_500"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTab3"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navIconBg3"
                android:layout_width="40dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivNavIcon3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Hồ sơ ngoại tuyến (§3)"
                    android:src="@drawable/ic_cached"
                    app:tint="@color/slate_500" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavLabel3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Hồ sơ"
                android:textColor="@color/slate_500"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTab4"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navIconBg4"
                android:layout_width="40dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivNavIcon4"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Ảnh thẻ sinh viên (§4)"
                    android:src="@drawable/ic_image"
                    app:tint="@color/slate_500" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavLabel4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Ảnh thẻ"
                android:textColor="@color/slate_500"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTab5"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navIconBg5"
                android:layout_width="40dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivNavIcon5"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Trung tâm bảo mật &amp; PIN (§5)"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/slate_500" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNavLabel5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Bảo mật"
                android:textColor="@color/slate_500"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
