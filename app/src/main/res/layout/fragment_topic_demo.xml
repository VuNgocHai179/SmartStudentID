<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/tvTopicBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SmartID.Label"
            android:textColor="@color/brand_600" />

        <TextView
            android:id="@+id/tvTopicTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SmartID.ScreenTitle" />

        <TextView
            android:id="@+id/tvTopicGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textAppearance="@style/TextAppearance.SmartID.Body" />

        <!-- Before / After switch (hidden for the §1 diagnosis page) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDemoMode"
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHẾ ĐỘ DEMO"
                        android:textAppearance="@style/TextAppearance.SmartID.Label"
                        android:textColor="@color/slate_500" />

                    <TextView
                        android:id="@+id/tvModeHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Before — chưa tối ưu"
                        android:textAppearance="@style/TextAppearance.SmartID.Micro"
                        android:textColor="@color/red_600" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDemoMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The user-facing action being demoed -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THAO TÁC NGƯỜI DÙNG"
                    android:textAppearance="@style/TextAppearance.SmartID.Label"
                    android:textColor="@color/slate_500" />

                <!-- Card profile panel (§1–§3) -->
                <LinearLayout
                    android:id="@+id/panelStudent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_soft_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/demoAvatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_icon_tile_blue"
                        android:contentDescription="Ảnh thẻ sinh viên"
                        android:padding="10dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        app:tint="@color/brand_600" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/demoName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Chưa có hồ sơ"
                            android:textColor="@color/slate_900"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/demoStudentId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.SmartID.Micro" />

                        <TextView
                            android:id="@+id/demoDept"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text=""
                            android:textAppearance="@style/TextAppearance.SmartID.Micro" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/demoSourceBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_slate"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text=""
                        android:textColor="@color/slate_600"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Image feature (§4) -->
                <LinearLayout
                    android:id="@+id/panelImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/demoImagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="@drawable/bg_soft_panel"
                        android:contentDescription="Ảnh chân dung sẽ lưu lên thẻ"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_image"
                        app:tint="@color/slate_400" />

                    <TextView
                        android:id="@+id/demoImageInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ảnh mẫu — chưa chọn ảnh"
                        android:textAppearance="@style/TextAppearance.SmartID.Micro" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickImage"
                        style="@style/Widget.SmartID.Button.Soft"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="Chọn ảnh từ thư viện"
                        app:icon="@drawable/ic_image" />
                </LinearLayout>

                <!-- PIN feature (§5) -->
                <LinearLayout
                    android:id="@+id/panelPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nhập PIN để mô phỏng đăng nhập"
                        android:textAppearance="@style/TextAppearance.SmartID.Micro" />

                    <EditText
                        android:id="@+id/demoPinInput"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:importantForAutofill="no"
                        android:inputType="number|textPassword"
                        android:maxLength="8"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="123456"
                        android:textColor="@color/slate_900"
                        android:textSize="16sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDemoAction"
                    style="@style/Widget.SmartID.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    app:icon="@drawable/ic_bolt" />

                <ProgressBar
                    android:id="@+id/demoProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDemoStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.SmartID.Micro" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetCache"
                    style="@style/Widget.SmartID.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_gravity="end"
                    android:text="Xóa cache (mô phỏng lần đầu)"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Realtime telemetry chart for every topic (§1–§5) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvRealtimeChartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ĐỒ THỊ REALTIME"
                    android:textAppearance="@style/TextAppearance.SmartID.Label"
                    android:textColor="@color/slate_500" />

                <TextView
                    android:id="@+id/tvRealtimeChartSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SmartID.Micro" />

                <com.example.smartstudentid.ui.widget.RealtimeTopicChartView
                    android:id="@+id/demoRealtimeChart"
                    android:layout_width="match_parent"
                    android:layout_height="172dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Before / After comparison filled by running each mode -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartID.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvComparisonTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SO SÁNH BEFORE / AFTER"
                    android:textAppearance="@style/TextAppearance.SmartID.Label"
                    android:textColor="@color/slate_500" />

                <LinearLayout
                    android:id="@+id/llComparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTopicHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_soft_panel"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.SmartID.Micro" />
    </LinearLayout>
</ScrollView>
