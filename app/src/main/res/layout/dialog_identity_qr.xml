<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="26dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/slate_200"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_blue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="Bảo mật"
                android:src="@drawable/ic_shield"
                app:tint="@color/brand_600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="RSA-1024 • Chu kỳ 30s"
                android:textAppearance="@style/TextAppearance.SmartID.Pill" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Mã QR định danh thẻ"
            android:textColor="@color/slate_900"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Xuất trình tại thư viện, phòng thi, cổng kiểm soát"
            android:textAppearance="@style/TextAppearance.SmartID.Caption" />

        <TextView
            android:id="@+id/tvIdentityQrStudentInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Vũ Ngọc Hải • CT070315 • Lớp CT7C"
            android:textColor="@color/slate_700"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="224dp"
            android:layout_height="224dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_qr_ring">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="184dp"
                android:layout_height="184dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/slate_200"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivIdentityQr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Mã QR định danh cá nhân 30 giây"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <ProgressBar
            android:id="@+id/pbIdentityQrCountdown"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="6dp"
            android:layout_marginTop="14dp"
            android:max="30"
            android:progress="30"
            android:progressDrawable="@drawable/progress_qr" />

        <TextView
            android:id="@+id/tvIdentityQrCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_blue"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="Đổi mã sau 30s"
            android:textColor="@color/brand_600"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swIdentityFlagSecure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_soft_panel"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Chống chụp màn hình (FLAG_SECURE)"
            android:textColor="@color/slate_700"
            android:textSize="12.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseIdentityQr"
            style="@style/Widget.SmartID.Button.Soft"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:text="Đóng" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
