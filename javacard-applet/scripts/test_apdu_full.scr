// ============================================================================
// JCIDE SIMULATOR APDU TEST SCRIPT (SC-08)
// Project: Multi-Purpose Smart Student ID System
// AID: A0 00 00 00 62 03 01 0C 06 01
// ============================================================================

// 1. SELECT APPLET (INS 0xA4)
00 A4 04 00 0A A0 00 00 00 62 03 01 0C 06 01 00;

// 2. TEST 3 CONSECUTIVE WRONG PIN ATTEMPTS TO LOCK THE CARD (INS 0x10 - Default PIN: "123456")
// Wrong attempt 1 -> Expected SW = 63C2 (2 tries remaining)
80 10 00 00 06 30 30 30 30 30 30;
// Wrong attempt 2 -> Expected SW = 63C1 (1 try remaining)
80 10 00 00 06 30 30 30 30 30 30;
// Wrong attempt 3 -> Expected SW = 6983 (Card is now locked)
80 10 00 00 06 30 30 30 30 30 30;

// 3. ADMIN UNBLOCKS CARD USING 8-DIGIT PUK "88888888" (INS 0x12) -> Expected SW = 9000
80 12 00 00 08 38 38 38 38 38 38 38 38;

// 4. VERIFY CORRECT PIN "123456" AFTER UNBLOCKING (INS 0x10) -> Expected SW = 9000
80 10 00 00 06 31 32 33 34 35 36;

// 5. EXPORT RSA-1024 PUBLIC KEY FROM CARD (INS 0x13)
// P1=01: Get Modulus N (128 bytes)
80 13 01 00 00;
// P1=02: Get Exponent E (3 bytes: 01 00 01)
80 13 02 00 00;

// 6. SIGN 16-BYTE NONCE CHALLENGE WITH RSA-1024 PRIVATE KEY (INS 0x14)
80 14 00 00 10 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F 10 00;

// 7. STORE AES-128 CBC ENCRYPTED STUDENT PROFILE IN EEPROM (INS 0x20)
// ASCII payload: "CT070315|Vu Ngoc Hai|15/08/2003|CT7C|CNTT" (41 bytes)
80 20 00 00 29 43 54 30 37 30 33 31 35 7C 56 75 20 4E 67 6F 63 20 48 61 69 7C 31 35 2F 30 38 2F 32 30 30 33 7C 43 54 37 43 7C 43 4E 54 54;

// 8. READ RAW AES-128 CIPHERTEXT FROM EEPROM FOR SECURITY VERIFICATION (INS 0x21, P1=01)
80 21 01 00 00;

// 9. READ DECRYPTED STUDENT PROFILE PLAINTEXT (INS 0x21, P1=00)
80 21 00 00 00;

// 10. RECORD CLASS ATTENDANCE WITH RSA SIGNATURE (INS 0x31, P1=01)
// Course code: 0x0101, Timestamp: 0x67210000
80 31 01 00 06 01 01 67 21 00 00 00;

// 11. BORROW LIBRARY BOOK INSIDE AN ATOMIC TRANSACTION (INS 0x31, P1=02)
// Book code: 0x0205, Timestamp: 0x67210010
80 31 02 00 06 02 05 67 21 00 10 00;

// 12. QUERY ACADEMIC & BORROWED BOOKS STATUS (INS 0x30)
80 30 00 00 00;

// 13. READ THE 10 LATEST ACTIVITIES FROM THE CIRCULAR BUFFER (INS 0x33)
80 33 00 00 00;
